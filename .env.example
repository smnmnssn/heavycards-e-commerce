# HeavyCards environment variables.
#
# Copy to `.env.local` for local development. Never commit real values:
# `.env*` files other than this example are git-ignored.
#
# Only variables marked "validated" are read by the application today. The
# others are reserved for later milestones and are listed so every environment
# (local, preview, production) can be prepared consistently. Each is added to
# `src/lib/env/schema.ts` when the feature that needs it is implemented.
#
# Next.js and prisma.config.ts both load `.env.local`; variables already set in
# the environment (CI, Vercel) take precedence.

# --- Application (validated) -------------------------------------------------
# Public origin used for canonical URLs, metadata and links in emails.
# Required for production builds/servers. On Vercel previews it falls back to
# the deployment URL; in local development it falls back to localhost:3000.
APP_URL=http://localhost:3000

# --- Database (validated) ----------------------------------------------------
# PostgreSQL connection URL, required everywhere (build, server, migrations).
# The value below matches the local database from `docker compose up -d`.
# Never point local development at the production database.
DATABASE_URL=postgresql://heavycards:heavycards@localhost:54320/heavycards

# Used only by `npm run test:db`, which empties every table. The database name
# must end in `_test`; it is created automatically if missing.
TEST_DATABASE_URL=postgresql://heavycards:heavycards@localhost:54320/heavycards_test

# Not used yet. A separate non-pooled URL for migrations may be required once
# the production PostgreSQL provider is chosen (Milestone 15).
# DIRECT_DATABASE_URL=

# The development seed refuses non-local databases unless this is "true".
# Only ever set it for a disposable staging/preview database.
# SEED_ALLOW_REMOTE_DATABASE=

# --- Admin authentication (Milestone 6) --------------------------------------
# Long random secret, e.g. `openssl rand -base64 32`. Unique per environment.
AUTH_SECRET=

# --- Stripe (Milestones 8–9) -------------------------------------------------
# Use test-mode keys (sk_test_…) everywhere except production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only needed if client-side Stripe.js is introduced; hosted Checkout does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email / Resend (Milestone 10) -------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "HeavyCards <order@example.com>".
EMAIL_FROM=

# --- Image storage (Milestone 7) ---------------------------------------------
# Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN=
