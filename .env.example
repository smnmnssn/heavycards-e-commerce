# HeavyCards environment variables.
#
# Copy to `.env.local` for local development. Never commit real values:
# `.env*` files other than this example are git-ignored.
#
# Only variables marked "validated" are read by the application today. The
# others are reserved for later milestones and are listed so every environment
# (local, preview, production) can be prepared consistently. Each is added to
# `src/lib/env/schema.ts` when the feature that needs it is implemented.
#
# Next.js and prisma.config.ts both load `.env.local`; variables already set in
# the environment (CI, Vercel) take precedence.

# --- Application (validated) -------------------------------------------------
# Public origin used for canonical URLs, metadata and links in emails.
# Required for production builds/servers. On Vercel previews it falls back to
# the deployment URL; in local development it falls back to localhost:3000.
APP_URL=http://localhost:3000

# --- Database (validated) ----------------------------------------------------
# PostgreSQL connection URL, required everywhere (build, server, migrations).
# The value below matches the local database from `docker compose up -d`.
# Never point local development at the production database.
DATABASE_URL=postgresql://heavycards:heavycards@localhost:54320/heavycards

# Used only by `npm run test:db`, which empties every table. The database name
# must end in `_test`; it is created automatically if missing.
TEST_DATABASE_URL=postgresql://heavycards:heavycards@localhost:54320/heavycards_test

# Not used yet. A separate non-pooled URL for migrations may be required once
# the production PostgreSQL provider is chosen (Milestone 15).
# DIRECT_DATABASE_URL=

# The development seed refuses non-local databases unless this is "true".
# Only ever set it for a disposable staging/preview database.
# SEED_ALLOW_REMOTE_DATABASE=

# --- Admin authentication (validated) ----------------------------------------
# Signs admin session cookies and keys the pseudonymous client IDs of rate
# limits and open-checkout caps. Required everywhere, at least 32 characters,
# e.g. `openssl rand -base64 32`. Unique per environment; rotating it signs
# every administrator out and resets rate-limit counters.
AUTH_SECRET=

# Derives the review links in shipping emails (never stored). Required in
# Vercel production, at least 32 characters, different from AUTH_SECRET.
# Outside production AUTH_SECRET is used when unset. Rotating it never breaks
# delivered links (they are looked up by hash); to keep emails that are still
# waiting to be sent renderable, move the old value to
# REVIEW_LINK_SECRET_PREVIOUS for a few days (docs/production-readiness.md).
REVIEW_LINK_SECRET=
# REVIEW_LINK_SECRET_PREVIOUS=

# Local development and E2E only: password given to the seeded administrators
# (owner@/admin@/inactive@heavycards.test) by `npm run db:seed`. At least 12
# characters. Leave unset to seed administrators without passwords. Never set
# this for a real environment.
# SEED_ADMIN_PASSWORD=

# --- Stripe (validated) -----------------------------------------------------
# Secret or restricted key for Stripe Hosted Checkout. Test-mode keys
# (sk_test_… / rk_test_…) everywhere except Vercel production, which requires
# a live key; live keys are refused anywhere else. Without a key the store
# runs, but checkout answers "payment unavailable".
STRIPE_SECRET_KEY=
# stripe (default): Stripe Checkout. fake: an in-process stand-in that never
# contacts Stripe, for local E2E runs only (refused on Vercel).
# PAYMENT_GATEWAY=
# With the fake gateway only: keep its sessions as JSON files (E2E tests edit
# them to simulate payments). Refused with the Stripe gateway.
# FAKE_STRIPE_STATE_DIR=
# Signing secret (whsec_…) of the webhook endpoint /api/stripe/webhook: printed
# by `stripe listen` locally, shown for the Dashboard endpoint on deployments.
# Required in Vercel production; without it the endpoint answers 503 and
# Stripe retries later.
STRIPE_WEBHOOK_SECRET=
# Only needed if client-side Stripe.js is introduced; hosted Checkout does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Scheduled jobs (validated) ----------------------------------------------
# Bearer secret Vercel Cron sends to /api/cron/reconcile-checkouts (at least 16
# characters, e.g. `openssl rand -base64 24`). Required in Vercel production;
# without it the route refuses every request.
CRON_SECRET=

# --- Email (validated) -------------------------------------------------------
# console (default outside Vercel production): nothing is sent, only logged.
# resend (default and required in Vercel production): real delivery.
# file: messages written to EMAIL_OUTBOX_DIR (E2E tests only).
# resend is refused when NODE_ENV=test, so test runs never email anyone.
# EMAIL_TRANSPORT=
# Resend API key (re_…). Use a sending-only key; production only in Vercel.
RESEND_API_KEY=
# Sender of admin and order emails: "address" or "Name <address>", on a domain
# verified in Resend, e.g. "HeavyCards <order@heavycards.se>". Vercel
# production refuses placeholder domains (example.com, .invalid, resend.dev).
EMAIL_FROM=
# EMAIL_OUTBOX_DIR=

# --- Product image storage (validated) ---------------------------------------
# Where uploaded product images are stored (src/lib/storage):
# - local (default outside Vercel): files in STORAGE_LOCAL_DIR (default
#   .storage/, git-ignored), served by /api/media. Needs no account. Refused
#   on Vercel, whose filesystem is not persistent.
# - vercel-blob (default, and the only option, on Vercel): a public Vercel
#   Blob store.
# STORAGE_PROVIDER=
# STORAGE_LOCAL_DIR=
# Read/write token of the Vercel Blob store. Vercel sets it automatically when
# a Blob store is connected to the project. Required in Vercel production; a
# preview without it keeps working, but image uploads fail with a clear admin
# message. Locally it is only needed to try real Blob uploads (together with
# STORAGE_PROVIDER=vercel-blob).
BLOB_READ_WRITE_TOKEN=
